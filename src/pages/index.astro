---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// Show the 10 most recent posts chronologically on page 1
const posts = allPosts.slice(0, 10);
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags || []))].sort();

function groupByMonth(postsList) {
	const map = new Map();
	for (const post of postsList) {
		const d = post.data.pubDate instanceof Date ? post.data.pubDate : new Date(post.data.pubDate);
		const validDate = isNaN(d.getTime()) ? new Date() : d;
		const key = `${validDate.getFullYear()}-${String(validDate.getMonth() + 1).padStart(2, '0')}`;
		map.set(key, (map.get(key) || 0) + 1);
	}
	return Array.from(map.entries())
		.sort((a, b) => b.localeCompare(a))
		.map(([key, count]) => {
			const [year, month] = key.split('-');
			const date = new Date(Number(year), Number(month) - 1);
			const label = date.toLocaleString('default', { month: 'long', year: 'numeric' });
			return { key, label, count, year, month };
		});
}
const archives = groupByMonth(allPosts);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero { position: relative; padding: 5rem 1rem 4rem; text-align: center; color: #fff; min-height: 320px; display: flex; align-items: center; justify-content: center; margin-top: 0; }
			.hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
			.hero-content { position: relative; z-index: 1; padding: 2rem; }
			.hero h1 { font-size: clamp(2rem, 5vw, 3.5rem); margin: 0 0 0.5rem; font-family: var(--font-display); color: #fff; text-shadow: 0 2px 4px rgba(0,0,0,0.5); }
			.hero p { font-size: 1.2rem; opacity: 0.95; max-width: 600px; margin: 0 auto; color: #fff; text-shadow: 0 1px 3px rgba(0,0,0,0.5); }
			.main-layout { display: flex; gap: 2rem; max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; box-sizing: border-box; }
			.main-content { flex: 1; min-width: 0; }
			.sidebar { flex: 0 0 280px; max-width: 280px; }
			.post-card { background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); margin-bottom: 1.5rem; }
			.post-card a { text-decoration: none; color: inherit; display: block; }
			.post-card img { width: 100%; height: 220px; object-fit: cover; background: #eee; }
			.post-card .content { padding: 1rem; }
			.post-card h3 { font-size: 1.2rem; margin: 0 0 0.5rem; font-weight: 700; color: #222; line-height: 1.3; }
			.post-card .meta { font-size: 0.85rem; color: #666; }
			.sidebar-widget { background: #fff; border-radius: 8px; padding: 1.2rem; margin-bottom: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
			.sidebar-widget h4 { margin: 0 0 0.75rem; font-size: 1rem; }
			.search-form input { width: 100%; padding: 0.6rem; border: 1px solid #ccc; border-radius: 4px; font-size: 0.95rem; }
			.tag-list { display: flex; flex-wrap: wrap; gap: 0.4rem; }
			.tag-list a { display: inline-block; padding: 0.25rem 0.6rem; background: #eee; border-radius: 4px; font-size: 0.8rem; color: #333; text-decoration: none; }
			.tag-list a:hover { background: var(--accent); color: #fff; }
			.archive-list { list-style: none; padding: 0; margin: 0; }
			.archive-list li { margin-bottom: 0.5rem; }
			.archive-list a { color: #333; text-decoration: none; font-size: 0.9rem; display: flex; justify-content: space-between; }
			.archive-list a:hover { color: var(--accent); }
			.pagination { display: flex; justify-content: center; gap: 0.5rem; margin-top: 3rem; padding: 1rem 0; }
			.pagination a, .pagination span { padding: 0.5rem 1rem; border-radius: 4px; text-decoration: none; color: #333; font-weight: 600; background: #eee; }
			.pagination .current { background: var(--accent); color: #fff; }
			@media (max-width: 840px) { .main-layout { flex-direction: column; } .sidebar { max-width: 100%; flex: none; } }
		</style>
	</head>
	<body>
		<Header />
		<div class="hero">
			<img src="/images/hero-header.jpg" alt="" class="hero-bg" />
			<div class="hero-content">
				<h1>My <strong>Speedway</strong>world Blog</h1>
				<p>the latest speedway world news!!</p>
			</div>
		</div>
		<div class="main-layout">
			<main class="main-content">
				{posts.map((post) => (
					<article class="post-card">
						<a href={`/blog/${post.slug || post.id}/`}>
							<img src={post.data.heroImage || '/images/hero-header.jpg'} alt="" />
							<div class="content">
								<h3>{post.data.title}</h3>
								<p class="meta">
									{(() => {
										const d = post.data.pubDate instanceof Date ? post.data.pubDate : new Date(post.data.pubDate);
										return !isNaN(d.getTime()) ? d.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
									})()}
									{post.data.tags && post.data.tags.length > 0 && ` • ${post.data.tags.join(', ')}`}
								</p>
							</div>
						</a>
					</article>
				))}
				
				<!-- CLEAN HOME PAGINATION CONTEXT -->
				<nav class="pagination" aria-label="Pagination">
					<span class="current">1</span>
					<a href="/blog/2/">Next &raquo;</a>
				</nav>
			</main>
			
			<aside class="sidebar">
				<div class="sidebar-widget">
					<h4>Search</h4>
					<form class="search-form" action="/search" method="get">
						<input type="search" name="q" placeholder="Search posts..." required minlength="3" />
					</form>
				</div>
				<div class="sidebar-widget">
					<h4>Popular Tags</h4>
					<div class="tag-list">
						{allTags.map((tag) => (
							<a href={`/tags/${tag}/`}>{tag}</a>
						))}
					</div>
				</div>
				<div class="sidebar-widget">
					<h4>Archives</h4>
					<ul class="archive-list">
						{archives.map((a) => (
							<li>
								<a href={`/archives/${a.year}/${a.month}/`}>
									<span>{a.label}</span>
									<span style="color:#666;">({a.count})</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</aside>
		</div> <!-- CRUCIAL CONTAINER CLOSURE FOR SIDEBAR GRIDS -->
		<Footer />
	</body>
</html>

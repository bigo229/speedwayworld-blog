---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { max-width: 960px; margin: 0 auto; padding: 3em 1em; }
			ul { display: flex; flex-wrap: wrap; gap: 2rem; list-style-type: none; margin: 0; padding: 0; }
			ul li { width: calc(50% - 1rem); }
			ul li img { margin-bottom: 0.5rem; border-radius: 12px; width: 100%; height: 240px; object-fit: cover; background: #eee; }
			ul li a { display: block; text-decoration: none; }
			.title { margin: 0; color: #222; line-height: 1.2; font-size: 1.2rem; font-weight: 700; }
			.date { margin: 0; color: #666; font-size: 0.9rem; }
			.pagination { display: flex; justify-content: center; gap: 0.5rem; margin-top: 3rem; }
			.pagination a, .pagination span { padding: 0.5rem 1rem; border-radius: 4px; text-decoration: none; color: #333; font-weight: 600; background: #eee; }
			.pagination .current { background: var(--accent); color: #fff; }
			@media (max-width: 720px) { ul { gap: 1rem; } ul li { width: 100%; } }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{posts.slice(0, 12).map((post) => (
						<li>
							<a href={`/blog/${post.slug || post.id}/`}>
								<img src={post.data.heroImage || '/images/hero-header.jpg'} alt="" />
								<h4 class="title">{post.data.title}</h4>
								<p class="date">
									{(() => {
										const d = post.data.pubDate instanceof Date ? post.data.pubDate : new Date(post.data.pubDate);
										return !isNaN(d.getTime()) ? d.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
									})()}
								</p>
							</a>
						</li>
					))}
				</ul>
			</section>
			
			<!-- CLEAN DYNAMIC BLOG PAGINATION CONTEXT -->
			<nav class="pagination" aria-label="Pagination">
				<a href="/">&larr; Home</a>
				<span class="current">1</span>
				<a href="/blog/2/">2</a>
				<a href="/blog/2/">Next &rarr;</a>
			</nav>
		</main>
		<Footer />
	</body>
</html>

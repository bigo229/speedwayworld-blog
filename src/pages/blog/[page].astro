---
import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths({ paginate }) {
	const allPosts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);
	return paginate(allPosts, { pageSize: 12 });
}

const { page } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<title>SpeedwayWorld Blog - Page {page.currentPage}</title>
	</head>
	<body>
		<main>
			<section>
				<ul>
					{
						page.data.map((post) => (
							<li>
								<a href={`/blog/${post.slug || post.id}/`}>
									<img width={720} height={360} src={post.data.heroImage} alt="" />
									<h4>{post.data.title}</h4>
									<p>
   {
      (() => {
         const d = post.data.pubDate instanceof Date ? post.data.pubDate : new Date(post.data.pubDate);
         return !isNaN(d.getTime()) ? d.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
      })()
   }
</p>

								</a>
							</li>
						))
					}
				</ul>

				<!-- Clean, Simple Pagination Controls -->
				<nav class="pagination">
					{page.url.prev ? <a href={page.url.prev}>&larr; Previous</a> : null}
					<span>Page {page.currentPage} of {page.lastPage}</span>
					{page.url.next ? <a href={page.url.next}>Next &rarr;</a> : null}
				</nav>
			</section>
		</main>
	</body>
</html>

<style>
	.pagination {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 2rem 0;
	}
	.pagination a {
		text-decoration: none;
		font-weight: bold;
		color: rgb(var(--gray-dark));
	}
</style>

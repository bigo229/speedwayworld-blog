---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

export async function getStaticPaths({ paginate }) {
	const allPosts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);
	return paginate(allPosts, { pageSize: 12 });
}

const { page } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog Archive - Page ${page.currentPage} | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { max-width: 960px; margin: 0 auto; padding: 3em 1em; }
			ul { display: flex; flex-wrap: wrap; gap: 2rem; list-style-type: none; padding: 0; margin: 0; }
			ul li { width: calc(50% - 1rem); }
			ul li img { border-radius: 12px; width: 100%; height: 240px; object-fit: cover; }
			.title { margin: 0; color: #333; text-decoration: none; }
			.pagination-nav { display: flex; justify-content: space-between; align-items: center; margin-top: 3rem; }
			.pagination-nav a { text-decoration: none; font-weight: bold; color: var(--accent); }
			@media (max-width: 720px) { ul li { width: 100%; } }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<ul>
				{page.data.map((post) => (
					<li>
						<a href={`/blog/${post.slug || post.id}/`}>
							{post.data.heroImage && <img src={post.data.heroImage} alt="" />}
							<h4 class="title">{post.data.title}</h4>
						</a>
					</li>
				))}
			</ul>
			<nav class="pagination-nav">
				{page.url.prev ? <a href={page.url.prev}>&larr; Previous</a> : <span></span>}
				<span>Page {page.currentPage} of {page.lastPage}</span>
				{page.url.next ? <a href={page.url.next}>Next &rarr;</a> : <span></span>}
			</nav>
		</main>
		<Footer />
	</body>
</html>

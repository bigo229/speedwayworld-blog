---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// Securely group posts by year and month, safely handling raw strings or dates
const groupedPosts = allPosts.reduce((acc, post) => {
	const dateObj = post.data.pubDate instanceof Date ? post.data.pubDate : new Date(post.data.pubDate);
	const validDate = isNaN(dateObj.getTime()) ? new Date() : dateObj;
	
	const year = validDate.getFullYear();
	const month = validDate.toLocaleString('en-US', { month: 'long' });
	const monthNum = (validDate.getMonth() + 1).toString().padStart(2, '0');

	if (!acc[year]) acc[year] = {};
	if (!acc[year][month]) acc[year][month] = { name: month, num: monthNum, posts: [] };
	
	acc[year][month].posts.push(post);
	return acc;
}, {});

const years = Object.keys(groupedPosts).sort((a, b) => Number(b) - Number(a));
---

<!DOCTYPE html>
<html lang="en">
<head>
	<title>Speedway Master Archives</title>
</head>
<body>
	<main>
		<h1>Blog Archives</h1>
		{years.map((year) => (
			<div>
				<h2>{year}</h2>
				{Object.keys(groupedPosts[year]).map((monthName) => {
					const monthData = groupedPosts[year][monthName];
					return (
						<h3>
							<a href={`/archives/${year}/${monthData.num}/`}>
								{monthName} ({monthData.posts.length} posts)
							</a>
						</h3>
					);
				})}
			</div>
		))}
	</main>
</body>
</html>

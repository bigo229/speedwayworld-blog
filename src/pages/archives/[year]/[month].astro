---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	const map = new Map();
	for (const post of posts) {
		const d = post.data.pubDate;
		const year = String(d.getFullYear());
		const month = String(d.getMonth() + 1).padStart(2, '0');
		const key = `${year}/${month}`;
		if (!map.has(key)) map.set(key, []);
		map.get(key).push(post);
	}
	return Array.from(map.entries()).map(([key, posts]) => {
		const [year, month] = key.split('/');
		const date = new Date(Number(year), Number(month) - 1);
		const label = date.toLocaleString('default', { month: 'long', year: 'numeric' });
		return {
			params: { year, month },
			props: { label, posts },
		};
	});
}

const { label, posts: archivePosts } = Astro.props;
const title = `Archive: ${label}`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={SITE_DESCRIPTION} />
		<style>
			.container {
				max-width: 800px;
				margin: 0 auto;
				padding: 2rem 1rem;
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.post-list li {
				border-bottom: 1px solid var(--text-lighter);
				padding: 1rem 0;
			}
			.post-list a {
				text-decoration: none;
				color: var(--text);
			}
			.post-list a:hover {
				color: var(--accent);
			}
			.post-list .title {
				font-size: 1.1rem;
				margin: 0 0 0.25rem;
			}
			.post-list .date {
				font-size: 0.85rem;
				color: var(--text-light);
			}
			.back-link {
				display: inline-block;
				margin-bottom: 1rem;
				color: var(--accent);
				text-decoration: none;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="container">
				<a href="/blog" class="back-link">&larr; Back to all posts</a>
				<h1>Archive: {label}</h1>
				<p>{archivePosts.length} post{archivePosts.length === 1 ? '' : 's'}</p>
				<ul class="post-list">
					{archivePosts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<h3 class="title">{post.data.title}</h3>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))}
				</ul>
			</div>
		</main>
		<Footer />
	</body>
</html>

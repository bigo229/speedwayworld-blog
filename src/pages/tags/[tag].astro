---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	const tags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))];

	return tags.map((tag) => {
		const filteredPosts = allPosts.filter((post) => 
			(post.data.tags || []).includes(tag)
		).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
		
		return {
			params: { tag },
			props: { posts: filteredPosts },
		};
	});
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Posts Tagged "${tag}" | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; }
			.grid { display: flex; flex-wrap: wrap; gap: 2rem; list-style: none; padding: 0; margin: 2rem 0 0; }
			.grid li { width: calc(50% - 1rem); }
			.post-card { background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); display: block; text-decoration: none; color: inherit; }
			.post-card img { width: 100%; height: 240px; object-fit: cover; }
			.content { padding: 1rem; }
			.title { margin: 0 0 0.5rem; font-size: 1.2rem; color: #222; }
			.date { margin: 0; font-size: 0.85rem; color: #666; }
			@media (max-width: 720px) { .grid li { width: 100%; } }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Posts tagged with "{tag}"</h1>
			<ul class="grid">
				{posts.map((post) => (
					<li>
						<a class="post-card" href={`/blog/${post.slug || post.id}/`}>
							{post.data.heroImage && <img src={post.data.heroImage} alt="" />}
							<div class="content">
								<h4 class="title">{post.data.title}</h4>
								<p class="date">
									{(() => {
										const d = post.data.pubDate instanceof Date ? post.data.pubDate : new Date(post.data.pubDate);
										return !isNaN(d.getTime()) ? d.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
									})()}
								</p>
							</div>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>

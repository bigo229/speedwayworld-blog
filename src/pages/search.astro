---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Search Results | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { max-width: 800px; margin: 0 auto; padding: 3em 1em; min-height: 60vh; }
			.search-box { margin-bottom: 2rem; }
			input { width: 100%; padding: 0.8rem; border: 1px solid #ccc; border-radius: 6px; font-size: 1rem; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Search Engine</h1>
			<div class="search-box">
				<form action="/search" method="get">
					<input type="search" name="q" placeholder="Type keywords here to search speedway stories..." required minlength="3" />
				</form>
			</div>
			<div id="search-results">
				<p style="color: #666;">Please use the entry box above to parse our live content database grids.</p>
			</div>
		</main>
		<Footer />
	</body>
</html>

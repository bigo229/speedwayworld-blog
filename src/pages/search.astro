---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const allPosts = await getCollection('blog');
const searchIndex = allPosts.map(post => ({
	title: post.data.title,
	slug: post.slug || post.id,
	date: post.data.pubDate
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Search Results | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { max-width: 800px; margin: 0 auto; padding: 3em 1em; min-height: 60vh; }
			.search-box { margin-bottom: 2rem; }
			input { width: 100%; padding: 0.8rem; border: 1px solid #ccc; border-radius: 6px; font-size: 1rem; }
			.result-item { margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid #eee; }
			.result-item a { text-decoration: none; color: var(--accent); font-weight: bold; font-size: 1.2rem; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Search Results</h1>
			<div class="search-box">
				<input type="text" id="search-input" placeholder="Type keywords here to filter speedway stories..." />
			</div>
			<div id="results-container"></div>
		</main>
		<Footer />

		<script define:vars={{ searchIndex }}>
			const params = new URLSearchParams(window.location.search);
			const query = params.get('q') || '';
			const input = document.getElementById('search-input');
			input.value = query;

			function runSearch(keyword) {
				const container = document.getElementById('results-container');
				if (!keyword.trim()) {
					container.innerHTML = '<p>Please enter keywords above.</p>';
					return;
				}
				const filtered = searchIndex.filter(post => 
					post.title.toLowerCase().includes(keyword.toLowerCase())
				);
				if (filtered.length === 0) {
					container.innerHTML = '<p>No speedway matches found.</p>';
					return;
				}
				container.innerHTML = filtered.map(post => `
					<div class="result-item">
						<a href="/blog/${post.slug}/">${post.title}</a>
					</div>
				`).join('');
			}

			runSearch(query);
			input.addEventListener('input', (e) => runSearch(e.target.value));
		</script>
	</body>
</html>

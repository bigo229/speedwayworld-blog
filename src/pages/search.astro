---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const allPosts = await getCollection('blog');
const searchIndex = allPosts.map(post => ({
	title: post.data.title || '',
	slug: post.slug || post.id || '',
	heroImage: post.data.heroImage || '/images/hero-header.jpg',
	dateText: post.data.pubDate instanceof Date 
		? post.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })
		: new Date(post.data.pubDate).toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Search Results | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { max-width: 960px; margin: 0 auto; padding: 3em 1em; min-height: 60vh; }
			.search-box { margin-bottom: 2rem; }
			input { width: 100%; padding: 0.8rem; border: 1px solid #ccc; border-radius: 6px; font-size: 1rem; }
			.grid { display: flex; flex-wrap: wrap; gap: 2rem; list-style: none; padding: 0; margin: 2rem 0 0; }
			.grid li { width: calc(50% - 1rem); }
			.post-card { background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); display: block; text-decoration: none; color: inherit; }
			.post-card img { width: 100%; height: 240px; object-fit: cover; background: #eee; }
			.content { padding: 1rem; }
			.title { margin: 0 0 0.5rem; font-size: 1.2rem; color: #222; font-weight: 700; line-height: 1.3; }
			.date { margin: 0; font-size: 0.85rem; color: #666; }
			@media (max-width: 720px) { .grid li { width: 100%; } }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Search Results</h1>
			<div class="search-box">
				<input type="text" id="search-input" placeholder="Type here to refine your search..." />
			</div>
			<ul class="grid" id="results-container"></ul>
		</main>
		<Footer />

		<script define:vars={{ searchIndex }}>
			function performSearch() {
				const urlParams = new URLSearchParams(window.location.search);
				const queryRaw = urlParams.get('q') || '';
				const queryStr = decodeURIComponent(queryRaw.replace(/\+/g, ' ')).trim().toLowerCase();
				
				const inputEl = document.getElementById('search-input');
				const containerEl = document.getElementById('results-container');
				
				if (queryStr) {
					inputEl.value = queryStr;
					const keywords = queryStr.split(/\s+/);
					
					const matches = searchIndex.filter(post => {
						const titleLower = post.title.toLowerCase();
						return keywords.every(word => titleLower.includes(word));
					});

					if (matches.length > 0) {
						containerEl.innerHTML = matches.map(post => `
							<li>
								<a class="post-card" href="/blog/${post.slug}/">
									<img src="${post.heroImage}" alt="" />
									<div class="content">
										<h4 class="title">${post.title}</h4>
										<p class="date">${post.dateText}</p>
									</div>
								</a>
							</li>
						`).join('');
						return;
					}
				}
				containerEl.innerHTML = '<p style="color:#666; padding: 1rem;">No matching articles found. Try another keyword string above!</p>';
			}

			window.addEventListener('DOMContentLoaded', performSearch);
			document.getElementById('search-input').addEventListener('keypress', (e) => {
				if (e.key === 'Enter') {
					window.location.search = `?q=${encodeURIComponent(e.target.value)}`;
				}
			});
		</script>
	</body>
</html>

---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

// 1. Strictly type your parameters using Astro's native Collection schema
type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags = [] } = Astro.props;
---

<html lang="en">
	<head>
		<!-- 2. Pass your dynamic metadata down into the component props -->
		<BaseHead 
			title={title} 
			description={description} 
			image={heroImage}
			type="article"
			publishedTime={pubDate ? new Date(pubDate).toISOString() : undefined}
			modifiedTime={updatedDate ? new Date(updatedDate).toISOString() : undefined}
			tags={tags}
		/>
		<style>
			/* Your existing component layout styling stays right here */
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class="main-content">
				<!-- Render the Hero Image if it exists -->
				{heroImage && <img width={720} height={360} src={heroImage} alt="" style="border-radius: 8px; margin-bottom: 1rem; width: 100%; height: auto; object-fit: cover;" />}
				
				<!-- Render the Title -->
				<h1 class="title" style="font-size: 2.5rem; margin-bottom: 0.5rem;">{title}</h1>
				
				<!-- Render the Date -->
				<div class="date-wrapper" style="color: var(--text-light); font-size: 0.9rem; margin-bottom: 2rem;">
					<FormattedDate date={pubDate} />
					{updatedDate && (
						<div class="last-updated-on">
							Last updated on <FormattedDate date={updatedDate} />
						</div>
					)}
				</div>
				
				<hr style="border: none; border-top: 1px solid var(--text-lighter); margin-bottom: 2rem;" />

				<!-- 🌟 THIS IS THE CRITICAL TAG THAT INJECTS YOUR MARKDOWN CONTENT -->
				<slot /> 

			</article>
		</main>
		<Footer />
	</body>

</html>
